# ── Required ─────────────────────────────────────────
# Random 32+ char string: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the site, e.g. https://mutqen.vercel.app
BETTER_AUTH_URL=http://localhost:3000
# Postgres connection string (Neon or Supabase). Empty = local embedded PGlite.
DATABASE_URL=

# Everything below is optional. Each feature works without its key and switches on with it.

# ── AI: writes the brief and grades the practical test (any OpenAI-compatible endpoint) ───
# Without it the site uses built-in question banks and rule-based grading.
# Gemini:     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   AI_MODEL=gemini-3.5-flash-lite
# Groq:       AI_BASE_URL=https://api.groq.com/openai/v1                           AI_MODEL=openai/gpt-oss-120b
# OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1                             AI_MODEL=<model id>
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ── Email (Resend): notification emails and "forgot password" ─────
# Without it, notifications appear in the site only and password reset is unavailable.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "متقن <no-reply@mutqen.sa>"
EMAIL_FROM=
# Shown on the terms and privacy pages
SUPPORT_EMAIL=
# WhatsApp number for the team, international digits (e.g. 9665XXXXXXXX). Shown in the footer and on orders.
SUPPORT_WHATSAPP=

# ── File uploads (Vercel Blob) ─────
# Added automatically when a Blob store is connected to the project. Without it, files are shared as links.
BLOB_READ_WRITE_TOKEN=

# ── Payments ─────
# Empty = test mode: every step runs, no money moves. See src/lib/payments.ts for the gateway boundary.
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=

# ── Phone verification by SMS (Authentica) ─────
AUTHENTICA_API_KEY=

# ── Scheduled job (Vercel Cron → /api/cron/sweep) ─────
# Random string; Vercel sends it as a bearer token.
CRON_SECRET=

# ── Demo / staging only ─────
# Shows a "sample data" banner. Never set on the live site.
DEMO_MODE=
# Passwords for the sample accounts created by `npm run db:seed` on a hosted database.
SEED_PASSWORD=
SEED_ADMIN_PASSWORD=
