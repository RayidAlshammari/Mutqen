# ── Required ─────────────────────────────────────────
# Random 32+ char string: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the site, e.g. https://mutqen.vercel.app
BETTER_AUTH_URL=http://localhost:3000
# Postgres connection string (Neon or Supabase). Empty = local embedded PGlite.
DATABASE_URL=

# ── AI (optional; any OpenAI-compatible endpoint) ───
# Gemini:     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   AI_MODEL=gemini-3.5-flash-lite
# Groq:       AI_BASE_URL=https://api.groq.com/openai/v1                           AI_MODEL=openai/gpt-oss-120b
# OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1                             AI_MODEL=<model id>
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ── Phone verification via Authentica (optional) ─────
AUTHENTICA_API_KEY=
